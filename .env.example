# Sao chép file này thành ".env" nếu muốn đổi cấu hình khi chạy trên máy cá nhân.
# Trên Railway: khai báo trong tab "Variables" của dịch vụ (không cần file .env).

# Cổng chạy web (Railway tự cấp biến PORT, không cần khai báo)
PORT=3000

# Đường dẫn file cơ sở dữ liệu (không bắt buộc).
# Nếu gắn Volume trên Railway, server tự lưu vào thư mục Volume – không cần khai báo dòng này.
# DB_PATH=./data/chemrescue.db

# Mã PIN mở Dashboard Giáo viên (BẮT BUỘC để giáo viên xem kết quả lớp học).
# Trên Railway: tab Variables → New Variable → TEACHER_PIN = (dãy số bí mật, vd 6 chữ số)
TEACHER_PIN=

# Múi giờ tính "hôm nay" và "7 ngày qua" (mặc định giờ Việt Nam)
# APP_TIMEZONE=Asia/Ho_Chi_Minh
